# ============================================================
# Nexora Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.

# --- Required: Supabase Public Client Credentials ---
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-key

# --- Required: Site URL (for auth redirects) ---
# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (set in Vercel):
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- Optional: Cloudflare Turnstile CAPTCHA ---
# Get keys from: https://dash.cloudflare.com/ → Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# (The secret key goes ONLY in Supabase Dashboard → Auth → Bot Protection)

# --- Google OAuth ---
# Configure in Supabase Dashboard → Auth → Providers → Google
# No environment variables needed in the app — Supabase handles it.

# ============================================================
# NEVER add these to source code or NEXT_PUBLIC_ variables:
# - SUPABASE_SERVICE_ROLE_KEY
# - SMTP passwords
# - CAPTCHA secret keys  
# - Google OAuth client secrets
# ============================================================
