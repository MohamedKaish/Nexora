APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:3000"]
MAX_UPLOAD_SIZE_MB=500
MAX_FRAMES_ANALYZED=32
MODEL_REPO_ID=accel69/depfake-detection
MODEL_FILENAME=ig.bin
MODEL_NAME=ResNeXt-101 32x8d Deepfake Detector

# Sprint 2 — Retention & warm-up settings
# Seconds before uploaded video files are deleted after job completion (default: 24h)
UPLOAD_TTL_SECONDS=86400
# Seconds before generated PDF reports are deleted (default: 7d)
REPORT_TTL_SECONDS=604800
# Seconds before completed/failed job records are evicted from memory (default: 24h)
JOB_TTL_SECONDS=86400
# Set to False to disable model warm-up at startup (delays load to first request)
MODEL_WARM_UP_ON_START=True
